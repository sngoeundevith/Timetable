rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ ដាក់អ៊ីមែល Admin របស់អ្នកនៅទីនេះ (អក្សរតូចទាំងអស់) — ត្រូវដូចគ្នានឹង adminEmails ក្នុង config.js
    function adminEmails() { return ['admin@example.com']; }

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in adminEmails();
    }
    function status(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.status : 'none';
    }

    match /users/{uid} {
      // អ្នកប្រើអានតែប្រវត្តិរូបខ្លួនឯង · Admin អានបានទាំងអស់
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // ចុះឈ្មោះ៖ បង្កើតតែប្រវត្តិរូបខ្លួនឯង ហើយស្ថានភាពត្រូវតែ "pending" ជានិច្ច
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'createdAt']);

      // មានតែ Admin ទេ ដែលអាចប្តូរស្ថានភាព (approved / pending / blocked)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt']);
      allow delete: if isAdmin();

      // ទិន្នន័យកាលវិភាគរបស់គណនី៖ ប្រើបានតែនៅពេលត្រូវបានយល់ព្រមហើយ (Admin ប្រើបានជានិច្ច)
      match /data/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid
          && (isAdmin() || status(uid) == 'approved');
        allow delete: if isAdmin();
      }
    }
  }
}
